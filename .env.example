# ==============================================================================
# AGRO MARCONATO AGROPECUÁRIA — VARIÁVEIS DE AMBIENTE DE PRODUÇÃO
# ==============================================================================

# URL pública da aplicação (usada para webhooks e links absolutos)
APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT="3000"

# ------------------------------------------------------------------------------
# SUPABASE (Banco de Dados PostgreSQL e Storage de Imagens)
# Copie os valores da aba "Connect -> Server" do seu projeto Supabase
# ------------------------------------------------------------------------------
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# Segredo criptográfico para assinatura de sessões JWT (gerar string aleatória 64+ chars em produção)
JWT_SECRET=""

# Inicialização segura do primeiro administrador (executada apenas se não houver admin no banco)
ADMIN_BOOTSTRAP_NOME="Administrador Agro Marconato"
ADMIN_BOOTSTRAP_CPF="52998224725"
ADMIN_BOOTSTRAP_EMAIL="admin@agromarconato.com.br"
ADMIN_BOOTSTRAP_TELEFONE="11999990000"
ADMIN_BOOTSTRAP_SENHA="Agro@2026!Admin"

# ------------------------------------------------------------------------------
# MERCADO PAGO (Pagamentos Reais: PIX, Cartão de Crédito e Webhooks)
# ------------------------------------------------------------------------------
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
MERCADOPAGO_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# ENVIO DE E-MAIL TRANSACIONAL (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Agro Marconato <noreply@agromarconato.com.br>"

# ------------------------------------------------------------------------------
# ENVIO DE CÓDIGO POR SMS / WHATSAPP (Twilio ou WhatsApp Cloud API)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ------------------------------------------------------------------------------
# VERIFICAÇÃO EXTERNA DE TITULARIDADE DE CPF (Opcional)
# ------------------------------------------------------------------------------
CPF_VERIFICATION_API_URL=""
CPF_VERIFICATION_API_KEY=""

# ------------------------------------------------------------------------------
# ATENDIMENTO OFICIAL WHATSAPP DA LOJA (somente dígitos com DDI 55)
# ------------------------------------------------------------------------------
STORE_WHATSAPP_NUMBER="5511999999999"
